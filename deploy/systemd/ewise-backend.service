[Unit]
Description=E-WISE Triage FastAPI Backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=aditama
WorkingDirectory=/home/aditama/Projects/ewise-triage/backend

# OpenMP membaca ini saat torch diimpor, jadi set_num_threads() saja sudah
# terlambat. Tiga core; satu (core 0) disisakan penuh untuk cloudflared.
Environment=OMP_NUM_THREADS=3
Environment=MKL_NUM_THREADS=3
Environment=TOKENIZERS_PARALLELISM=false

# Core 0 disisakan sepenuhnya untuk cloudflared (lihat ewise-tunnel.service).
# Tanpa ini, torch menjenuhkan semua 4 core dan cloudflared kelaparan giliran
# proses -> koneksi QUIC dianggap mati saat inferensi berat -> 502 pengguna.
AllowedCPUs=1-3

ExecStart=/home/aditama/Projects/ewise-triage/backend/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 10000 --timeout-keep-alive 65
Restart=always
RestartSec=5

# Model dipramuat dan dipanaskan saat startup; beri waktu, jangan dibunuh OOM.
TimeoutStartSec=300
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
